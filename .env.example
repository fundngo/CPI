# Anthropic API key — required for PDF credit-report auto-extraction.
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Port the server listens on. Railway sets this automatically.
PORT=5000

# Optional. Path to the SQLite database file.
# Locally: leave unset (defaults to ./data.db).
# Railway: set to /data/data.db and mount a Volume at /data so client data
# survives redeploys.
DATABASE_PATH=

# Optional. Claude model used for extraction (default: claude-opus-5-5).
CLAUDE_MODEL=

# Optional. Reasoning effort for extraction: low | medium | high | xhigh | max.
# Leave blank to use the model's default. Only set this for models that support it.
CLAUDE_EFFORT=

# Optional. Max pages read when a PDF has to be read as images (default 40, max 100).
VISION_MAX_PAGES=

# Optional. Sample clients are created automatically in local development when
# the database is empty. They are never created in production unless this is "true".
# Set to "false" to turn them off locally too.
SEED_SAMPLE_DATA=
